#pragma once

#define SKEIN_BUILD_DEBUG @SKEIN_BUILD_DEBUG_VALUE@
#define SKEIN_BUILD_RELEASE @SKEIN_BUILD_RELEASE_VALUE@
#define SKEIN_ENABLE_ASSERTS @SKEIN_ENABLE_ASSERTS_VALUE@
#define SKEIN_ENABLE_TRACING @SKEIN_ENABLE_TRACING_VALUE@

#define SKEIN_ENGINE_NAME "@PROJECT_NAME@"
#define SKEIN_ENGINE_VERSION "@PROJECT_VERSION@"
#define SKEIN_ENGINE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define SKEIN_ENGINE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define SKEIN_ENGINE_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define SKEIN_COMPILER_NAME "@CMAKE_CXX_COMPILER_ID@"
#define SKEIN_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@"

#if (SKEIN_BUILD_DEBUG + SKEIN_BUILD_RELEASE) != 1
#error "Exactly one SKEIN build mode must be active."
#endif
